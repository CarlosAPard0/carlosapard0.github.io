---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import Certifications from '../../components/Certifications.astro';
import Courses from '../../components/Courses.astro';
import EducationLanguages from '../../components/EducationLanguages.astro';
import profileData from '../../data/profile-and-skills.json';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.id.startsWith('en/') && project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const skillCategories = [
  {
    category: "Cloud & Data Engineering",
    skills: profileData.technical_skills.data_engineering_analytics
  },
  {
    category: "AI & Machine Learning",
    skills: profileData.technical_skills.ai_machine_learning
  },
  {
    category: "Cybersecurity & Infrastructure",
    skills: profileData.technical_skills.networking_security_databases
  },
  {
    category: "Backend & DevOps",
    skills: profileData.technical_skills.devops_backend
  }
];
---

<BaseLayout title="Carlos A. Pardo | Data Engineering, Cloud & Cybersecurity">
  <Navbar lang="en" currentPath="/en" />

  <main class="max-w-6xl mx-auto px-6 py-12 space-y-24">
    <!-- Hero / Identity with Prominent Vertical Portrait -->
    <section class="pt-4 pb-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Main Content & Overview -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Telecommunications Engineer | Data, Cloud & Cybersecurity
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Data Engineering, Cloud Architectures & Cybersecurity.
          </h1>

          <p class="text-base sm:text-lg text-zinc-400 leading-relaxed">
            Specialized in the complete data lifecycle and critical infrastructure resilience: scalable pipelines using <strong class="text-zinc-200">Azure, Airflow, and Spark</strong>, production <strong class="text-zinc-200">AI Agents</strong> with FastAPI, and continuous technical audits across <strong class="text-zinc-200">cybersecurity and networking</strong>.
          </p>

          <!-- Direct Links to GitHub and LinkedIn -->
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-mono">
            <a
              href="https://github.com/CarlosAPard0"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-2 rounded-lg bg-zinc-900 border border-zinc-800 hover:border-zinc-500 text-zinc-200 hover:text-white transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md hover:shadow-zinc-950/20 inline-flex items-center gap-2"
            >
              <span>GitHub</span>
              <span aria-hidden="true">&nearr;</span>
            </a>

            <a
              href="https://www.linkedin.com/in/carlos-a-pardo-27569a37a/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-2 rounded-lg bg-zinc-900 border border-zinc-800 hover:border-zinc-500 text-zinc-200 hover:text-white transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md hover:shadow-zinc-950/20 inline-flex items-center gap-2"
            >
              <span>LinkedIn</span>
              <span aria-hidden="true">&nearr;</span>
            </a>

            <a
              href="mailto:carlosandrespardocastro@gmail.com"
              class="px-3.5 py-2 rounded-lg bg-zinc-900 border border-zinc-800 hover:border-zinc-500 text-zinc-200 hover:text-white transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md hover:shadow-zinc-950/20 inline-flex items-center gap-2"
            >
              <span>Email</span>
              <span aria-hidden="true">&nearr;</span>
            </a>

            <a
              href="/en/projects"
              class="px-3.5 py-2 rounded-lg bg-zinc-800/80 border border-zinc-700/80 hover:border-zinc-500 text-zinc-100 hover:text-white transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md hover:shadow-zinc-950/20 inline-flex items-center gap-1.5 font-semibold"
            >
              <span>View Projects</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Prominent Vertical Portrait Photograph -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="w-64 sm:w-80 md:w-96 aspect-[3/4] rounded-2xl overflow-hidden border-2 border-zinc-700/80 shadow-2xl shadow-black/60 bg-zinc-900">
            <img
              src="/avatar.jpg"
              alt="Carlos A. Pardo photograph"
              class="w-full h-full object-cover object-top"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Professional Experience Timeline -->
    <section class="space-y-8">
      <div class="border-b border-zinc-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-white">Experience & Career</h2>
        <p class="text-xs text-zinc-400 mt-1 font-mono">
          Technical roles, infrastructure management, and data engineering projects
        </p>
      </div>

      <ExperienceTimeline lang="en" />
    </section>

    <!-- Featured Projects -->
    <section class="space-y-8">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-white">Featured Projects</h2>
          <p class="text-xs text-zinc-400 mt-1 font-mono">
            End-to-end data architectures, applied analytics, and intelligent systems
          </p>
        </div>
        <a
          href="/en/projects"
          class="text-xs sm:text-sm font-semibold text-zinc-300 hover:text-white transition flex items-center gap-1 font-mono bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-600 px-3 py-1.5 rounded-lg"
        >
          <span>View all projects</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            technologies={project.data.technologies}
            githubUrl={project.data.githubUrl}
            demoUrl={project.data.demoUrl}
            image={project.data.image}
            slug={project.id.replace(/^en\//, '')}
            lang="en"
          />
        ))}
      </div>
    </section>

    <!-- Skills and Technical Stack -->
    <section class="space-y-8">
      <div class="border-b border-zinc-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-white">Skills & Technical Stack</h2>
        <p class="text-xs text-zinc-400 mt-1 font-mono">
          Technologies, frameworks, and tooling operated in production environments
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {skillCategories.map((cat) => (
          <div class="bg-zinc-900/40 border border-zinc-800 rounded-xl p-5 space-y-3.5 transition-all duration-300 ease-out hover:-translate-y-1.5 hover:bg-zinc-800/80 hover:border-zinc-400 hover:shadow-xl hover:shadow-black/40">
            <h3 class="text-xs font-mono font-semibold text-zinc-200 uppercase tracking-wider border-b border-zinc-800/80 pb-2">
              {cat.category}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {cat.skills.map((skill: string) => (
                <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-zinc-800/60 text-zinc-300 border border-zinc-700/50">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education & Languages -->
    <section class="space-y-8">
      <div class="border-b border-zinc-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-white">Education & Languages</h2>
        <p class="text-xs text-zinc-400 mt-1 font-mono">
          Academic university background and technical language proficiencies
        </p>
      </div>

      <EducationLanguages lang="en" />
    </section>

    <!-- Official Certifications -->
    <section class="space-y-8">
      <div class="border-b border-zinc-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-white">Official Certifications</h2>
        <p class="text-xs text-zinc-400 mt-1 font-mono">
          Verifiable industry credentials in Data Engineering, AI, Cybersecurity, and Cloud
        </p>
      </div>

      <Certifications lang="en" />
    </section>

    <!-- Courses & Specializations -->
    <section class="space-y-8">
      <div class="border-b border-zinc-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-white">Courses & Specializations</h2>
        <p class="text-xs text-zinc-400 mt-1 font-mono">
          Validated coursework and tracks in containerization, cloud fundamentals, analytics, and LLMs
        </p>
      </div>

      <Courses lang="en" />
    </section>
  </main>

  <Footer lang="en" />
</BaseLayout>
